    "%@ at %@": {
      "comment": "(Today/Tomorrow/Yesterday) at (time)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ at %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ does not start an automatic search when adding media, but you can.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not start an automatic search when adding media, but you can."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在添加媒体时不会自动搜索，但你可以手动搜索。"
          }
        }
      }
    },
